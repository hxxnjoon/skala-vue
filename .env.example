# 이 파일을 복사해 .env.local 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore 에 걸려 있어 저장소에 올라가지 않습니다.

# OpenWeatherMap (https://openweathermap.org/api) 에서 발급받은 API 키
VITE_OPENWEATHER_API_KEY=
VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Kakao Developers(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
# 발급 후 반드시 "제품 설정 > 카카오맵"을 활성화해야 정상 동작합니다.
VITE_KAKAO_REST_API_KEY=
